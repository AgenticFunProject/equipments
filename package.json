{
  "name": "equipments-service",
  "version": "0.2.3",
  "private": true,
  "description": "Container equipments and inventory service",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/playground && cp src/playground/* dist/src/playground/ && cp package.json dist/package.json",
    "migrate": "node dist/src/persistence/migrate.js",
    "migrate:status": "node dist/src/persistence/migrate.js status",
    "migrate:dev": "node --import tsx src/persistence/migrate.ts",
    "migrate:status:dev": "node --import tsx src/persistence/migrate.ts status",
    "start": "node dist/src/index.js",
    "test": "npm run test:non-gherkin && npm run test:gherkin",
    "test:non-gherkin": "node --import tsx --test test/persistence.test.ts test/service.test.ts",
    "test:gherkin": "node --import tsx --test test/gherkin-demo.test.ts",
    "sync:github-board": "node scripts/sync-github-board.mjs"
  },
  "dependencies": {
    "fastify": "^5.3.0",
    "pg": "^8.16.3",
    "umzug": "^3.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
